	description="Liên hệ Nam Thanh Car để thuê xe tại TP.HCM. Hotline: 0938 881 891. Hỗ trợ 24/7, tư vấn miễn phí."
	routeKey="contact"
>
	<ContactPageContent locale={locale} />
</Layout>
