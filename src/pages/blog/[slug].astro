---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { ArrowLeft } from "lucide-react";
import BlogCta from "@/components/blog/BlogCta.astro";
import Layout from "@/layouts/Layout.astro";
import { getLocaleFromUrl } from "@/i18n/translations";
import { localePath } from "@/i18n/paths";

const { slug } = Astro.params;
const posts = await getCollection("blog");
const post = posts.find((p) => p.id === slug && p.data.locale === "vi");

if (!post) return Astro.redirect("/blog");

const { Content } = await render(post);
const locale = getLocaleFromUrl(Astro.url);

function formatDate(date: Date): string {
	return date.toLocaleDateString("vi-VN", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
}
---

<Layout
	title={`${post.data.title} – Nam Thanh Car`}
	description={post.data.description}
	routeKey="blog"
	disableHreflang={true}
	ogType="article"
	breadcrumbItems={[
		{ name: "Trang chủ", url: "https://namthanhcar.net/" },
		{ name: "Blog", url: "https://namthanhcar.net/blog/" },
		{ name: post.data.title, url: new URL(`/blog/${slug}/`, Astro.site).href },
	]}
>
	<Fragment slot="head">
		<!-- VI-only posts: self-referencing hreflang, no EN alternate -->
		<link
			rel="alternate"
			hreflang="vi-VN"
			href={new URL(`/blog/${slug}/`, Astro.site)}
		/>
		<link
			rel="alternate"
			hreflang="x-default"
			href={new URL(`/blog/${slug}/`, Astro.site)}
		/>
		<meta
			property="article:published_time"
			content={post.data.date.toISOString()}
		/>
		<meta property="article:author" content="Nam Thanh Car" />
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				headline: post.data.title,
				description: post.data.description,
				datePublished: post.data.date.toISOString(),
				dateModified: post.data.date.toISOString(),
				author: {
					"@type": "Organization",
					name: "Nam Thanh Car",
					url: "https://namthanhcar.net/",
				},
				publisher: {
					"@type": "Organization",
					name: "Nam Thanh Car",
					url: "https://namthanhcar.net/",
					logo: {
						"@type": "ImageObject",
						url: "https://namthanhcar.net/logo.webp",
					},
				},
				url: new URL(`/blog/${slug}/`, Astro.site).href,
				inLanguage: "vi",
				mainEntityOfPage: {
					"@type": "WebPage",
					"@id": new URL(`/blog/${slug}/`, Astro.site).href,
				},
				isPartOf: {
					"@type": "Blog",
					name: "Blog – Nam Thanh Car",
					url: "https://namthanhcar.net/blog/",
				},
			})}
		/>
	</Fragment>
	<article class="py-16 md:py-24">
		<div class="container mx-auto px-4 max-w-3xl">
			<!-- Back link -->
			<a
				href={localePath(locale, "blog")}
				class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors mb-8"
			>
				<ArrowLeft className="w-4 h-4" />
				Blog
			</a>

			<!-- Header -->
			<header class="mb-10">
				<div class="flex items-center gap-3 text-sm text-muted-foreground mb-4">
					<time datetime={post.data.date.toISOString()}>
						{formatDate(post.data.date)}
					</time>
					<span class="w-1 h-1 rounded-full bg-muted-foreground/50"></span>
					<span>{post.data.author}</span>
				</div>
				<h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">
					{post.data.title}
				</h1>
				<p class="text-lg text-muted-foreground">
					{post.data.description}
				</p>
			</header>

			{
				post.data.cover && (
					<Image
						src={post.data.cover}
						alt={post.data.title}
						class="w-full rounded-xl mb-10 aspect-[2/1] object-cover"
					/>
				)
			}

			<!-- Content -->
			<div
				class="prose dark:prose-invert prose-lg max-w-none
				prose-headings:font-semibold prose-headings:tracking-tight
				prose-a:text-primary prose-a:no-underline hover:prose-a:underline
				prose-strong:text-foreground
				prose-li:marker:text-primary/60
				prose-table:border-border prose-th:border-border prose-td:border-border"
			>
				<Content />
			</div>

			<BlogCta locale={locale} cta={post.data.cta} />
		</div>
	</article>
</Layout>
