---
import { getCollection } from "astro:content";
import CtaSection from "@/components/home/CtaSection.astro";
import FleetPreview from "@/components/home/FleetPreview.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import PartnersSection from "@/components/home/PartnersSection.astro";
import RentalTypes from "@/components/home/RentalTypes.astro";
import StatsSection from "@/components/home/StatsSection.astro";
import { getLocaleFromUrl } from "@/i18n/translations";
import Layout from "@/layouts/Layout.astro";

const locale = getLocaleFromUrl(Astro.url);

const allCars = await getCollection("cars");
const featuredCars = allCars.filter((c) => c.data.available).slice(0, 3);
---

<Layout
	title="Nam Thanh Car – Thuê xe uy tín TP.HCM"
	description="Dịch vụ thuê xe theo ngày và theo tháng tại TP.HCM. Đội xe đa dạng 4–7 chỗ, tài xế chuyên nghiệp, giá cả minh bạch."
	routeKey="home"
>
	<HeroSection locale={locale} />
	<StatsSection locale={locale} />
	<FleetPreview locale={locale} cars={featuredCars} />
	<PartnersSection locale={locale} />
	<RentalTypes locale={locale} />
	<CtaSection locale={locale} />
</Layout>
