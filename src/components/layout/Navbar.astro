---
import { Menu, ChevronDown, Plane, Heart } from "lucide-react";
import { getLocaleFromUrl } from "@/i18n/translations";
import { localePath, type RouteKey } from "@/i18n/paths";
import { useTranslations } from "@/i18n/translations";
import { CONTACT } from "@/lib/constants";
import LangTabs from "@/components/ui/lang-tabs";

interface Props {
	routeKey?: RouteKey;
}

const { routeKey = "home" } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const navLinks = [
	{ key: "home", label: t.nav.home },
	{ key: "fleet", label: t.nav.fleet },
	{ key: "about", label: t.nav.about },
	{ key: "contact", label: t.nav.contact },
	{ key: "blog", label: t.nav.blog },
] satisfies { key: RouteKey; label: string }[];

const serviceLinks = locale === "vi"
	? [
		{ href: "/dich-vu/dua-don-san-bay/", label: "Đưa đón sân bay", icon: "plane" },
		{ href: "/dich-vu/cuoi-hoi/", label: "Cho thuê xe cưới", icon: "heart" },
	  ]
	: [];

const viHref = localePath("vi", routeKey);
const enHref = localePath("en", routeKey);
---

<header
	class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-border"
>
	<nav class="container mx-auto px-4 h-16 flex items-center justify-between">
		<!-- Logo -->
		<a
			href={localePath(locale, "home")}
			class="flex items-center gap-2 font-bold text-xl"
		>
			<span class="text-primary">Nam Thanh</span>
			<span class="text-muted-foreground font-normal">Car</span>
		</a>

		<!-- Desktop nav -->
		<ul class="hidden md:flex items-center gap-8">
			{
				navLinks.map(({ key, label }) => (
					<li>
						<a
							href={localePath(locale, key)}
							class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
						>
							{label}
						</a>
					</li>
				))
			}
			{serviceLinks.length > 0 && (
				<li class="relative group">
					<button class="flex items-center gap-1 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
						Dịch vụ
						<ChevronDown size={14} class="transition-transform group-hover:rotate-180" />
					</button>
					<div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 hidden group-hover:block">
						<ul class="bg-card border border-border rounded-xl shadow-lg py-2 min-w-[200px]">
							{serviceLinks.map(({ href, label, icon }) => (
								<li>
									<a
										href={href}
										class="flex items-center gap-3 px-4 py-2.5 text-sm text-muted-foreground hover:text-foreground hover:bg-muted/40 transition-colors"
									>
										{icon === "plane"
											? <Plane size={15} class="shrink-0 text-primary" />
											: <Heart size={15} class="shrink-0 text-primary" />
										}
										{label}
									</a>
								</li>
							))}
						</ul>
					</div>
				</li>
			)}
		</ul>

		<!-- Right actions -->
		<div class="flex items-center gap-3">
			<button
				id="theme-toggle"
				aria-label="Toggle theme"
				class="p-2 text-muted-foreground hover:text-foreground transition-colors"
			>
				<!-- Sun (shown in dark mode) -->
				<svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
					<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
				</svg>
				<!-- Moon (shown in light mode) -->
				<svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
				</svg>
			</button>
			<LangTabs locale={locale} viHref={viHref} enHref={enHref} client:load />
			<a
				href={CONTACT.ZALO_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden md:inline-flex items-center gap-1.5 bg-primary text-primary-foreground text-sm font-medium px-4 py-2 rounded-md hover:bg-primary/90 transition-colors"
			>
				Zalo
			</a>
			<button
				id="mobile-menu-btn"
				aria-label="Menu"
				class="md:hidden p-2 text-muted-foreground hover:text-foreground"
			>
				<Menu size={20} />
			</button>
		</div>
	</nav>

	<!-- Mobile menu -->
	<div
		id="mobile-menu"
		class="hidden md:hidden border-t border-border bg-background"
	>
		<ul class="container mx-auto px-4 py-4 flex flex-col gap-4">
			{
				navLinks.map(({ key, label }) => (
					<li>
						<a
							href={localePath(locale, key)}
							class="block text-sm font-medium text-muted-foreground hover:text-foreground"
						>
							{label}
						</a>
					</li>
				))
			}
			{serviceLinks.length > 0 && (
				<>
					<li class="text-xs font-semibold uppercase tracking-widest text-muted-foreground/60 pt-1">Dịch vụ</li>
					{serviceLinks.map(({ href, label, icon }) => (
						<li>
							<a
								href={href}
								class="flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground"
							>
								{icon === "plane"
									? <Plane size={14} class="text-primary shrink-0" />
									: <Heart size={14} class="text-primary shrink-0" />
								}
								{label}
							</a>
						</li>
					))}
				</>
			)}
			<li>
				<a
					href={CONTACT.ZALO_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 bg-primary text-primary-foreground text-sm font-medium px-4 py-2 rounded-md"
				>
					Zalo
				</a>
			</li>
		</ul>
	</div>
</header>

<script>
	const btn = document.getElementById("mobile-menu-btn");
	const menu = document.getElementById("mobile-menu");
	btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));

	const themeBtn = document.getElementById("theme-toggle");
	const sun = document.getElementById("icon-sun");
	const moon = document.getElementById("icon-moon");

	function applyTheme(dark: boolean) {
		document.documentElement.classList.toggle("dark", dark);
		sun?.classList.toggle("hidden", !dark);
		moon?.classList.toggle("hidden", dark);
		localStorage.setItem("theme", dark ? "dark" : "light");
	}

	// Init icon state from current class
	applyTheme(document.documentElement.classList.contains("dark"));

	themeBtn?.addEventListener("click", () => {
		applyTheme(!document.documentElement.classList.contains("dark"));
	});
</script>
