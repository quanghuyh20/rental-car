---
import { ArrowRight, Plane, Heart } from 'lucide-react';
import type { Locale } from '@/i18n/translations';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

// Only show for Vietnamese locale — service pages are VI only
if (locale !== 'vi') return;

const services = [
	{
		href: '/dich-vu/dua-don-san-bay/',
		label: 'Đưa đón sân bay',
		tagline: 'Tân Sơn Nhất',
		desc: 'Theo dõi giờ bay thực tế — bay trễ hay sớm đều tự điều chỉnh. Giá cố định, không phát sinh.',
		icon: 'plane',
		badge: '24/7',
	},
	{
		href: '/dich-vu/cuoi-hoi/',
		label: 'Xe cưới',
		tagline: 'Sang trọng, đúng giờ',
		desc: 'Kia Carnival, Toyota Innova trang trí hoa tươi — tài xế mặc vest, phối hợp nhịp nhàng với ekip ảnh.',
		icon: 'heart',
		badge: 'Đặt trước',
	},
];
---

<section class="container mx-auto px-4 py-20">
	<div class="text-center mb-12">
		<h2 class="text-3xl font-bold">Dịch vụ đặc biệt</h2>
		<p class="mt-3 text-muted-foreground">Ngoài thuê xe theo ngày và theo tháng, chúng tôi còn phục vụ</p>
	</div>

	<div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
		{services.map(({ href, label, tagline, desc, icon, badge }) => (
			<a
				href={href}
				class="group relative rounded-xl border border-border bg-card p-8 hover:border-primary/40 hover:shadow-md transition-all duration-200"
			>
				<div class="absolute top-4 right-4 text-xs bg-muted text-muted-foreground px-2 py-0.5 rounded-full font-medium">
					{badge}
				</div>
				<div class="h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-5">
					{icon === 'plane'
						? <Plane size={24} class="text-primary" strokeWidth={1.5} />
						: <Heart size={24} class="text-primary" strokeWidth={1.5} />
					}
				</div>
				<div class="text-xs font-semibold uppercase tracking-widest text-primary mb-1">{tagline}</div>
				<h3 class="text-xl font-bold mb-3">{label}</h3>
				<p class="text-muted-foreground leading-relaxed mb-5">{desc}</p>
				<span class="inline-flex items-center gap-1.5 text-primary text-sm font-medium group-hover:underline">
					Xem chi tiết
					<ArrowRight size={14} class="transition-transform group-hover:translate-x-0.5" />
				</span>
			</a>
		))}
	</div>
</section>
