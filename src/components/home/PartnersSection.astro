---
import {
	partner1,
	partner2,
	partner3,
	partner4,
	partner5,
	partner6,
	partner7,
	partner8,
} from "@/assets";
import { type Locale } from "@/i18n/translations";
import InfinitePartners from "./InfinitePartners";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;

const partners = [
	{ src: partner1.src, alt: "Nissei Corporation – đối tác Nam Thanh Car" },
	{ src: partner2.src, alt: "Nam Thanh Co., Ltd – logo" },
	{ src: partner3.src, alt: "T.A.P Pharmaceutical – đối tác Nam Thanh Car" },
	{ src: partner4.src, alt: "GACEPO Trading & Services – đối tác Nam Thanh Car" },
	{ src: partner5.src, alt: "HomeLab – đối tác Nam Thanh Car" },
	{ src: partner6.src, alt: "MapperKit – đối tác Nam Thanh Car" },
	{ src: partner7.src, alt: "CircleBot – đối tác Nam Thanh Car" },
	{ src: partner8.src, alt: "HomeLab – đối tác Nam Thanh Car" },
];
---

<section class="border-t border-border py-12">
	<p
		class="text-xs uppercase tracking-[0.3em] text-muted-foreground text-center mb-8"
	>
		{locale === "vi" ? "Đối tác tin cậy" : "Trusted partners"}
	</p>
	<InfinitePartners items={partners} speed="fast" client:load />
</section>
