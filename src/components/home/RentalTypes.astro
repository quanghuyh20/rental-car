---
import { ArrowRight, CalendarDays, CalendarRange } from 'lucide-react';
import { useTranslations, type Locale } from '@/i18n/translations';
import { localePath } from '@/i18n/paths';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="bg-muted/20 border-y border-border">
	<div class="container mx-auto px-4 py-20">
		<div class="text-center mb-12">
			<h2 class="text-3xl font-bold">{t.rental.title}</h2>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
			<!-- Daily -->
			<div class="rounded-xl border border-border bg-card p-8">
				<div class="h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-5">
					<CalendarDays size={24} class="text-primary" strokeWidth={1.5} />
				</div>
				<h3 class="text-xl font-bold mb-3">{t.rental.dayTitle}</h3>
				<p class="text-muted-foreground leading-relaxed mb-6">{t.rental.dayDesc}</p>
				<a
					href={localePath(locale, 'contact')}
					class="inline-flex items-center gap-1.5 text-primary text-sm font-medium hover:underline"
				>
					{t.rental.learnMore}
					<ArrowRight size={14} />
				</a>
			</div>

			<!-- Monthly (popular) -->
			<div class="rounded-xl border border-primary/30 bg-card p-8 relative">
				<div class="absolute top-4 right-4 text-xs bg-primary text-primary-foreground px-2 py-0.5 rounded-full font-medium">
					{locale === 'vi' ? 'Phổ biến' : 'Popular'}
				</div>
				<div class="h-12 w-12 rounded-lg bg-primary/10 flex items-center justify-center mb-5">
					<CalendarRange size={24} class="text-primary" strokeWidth={1.5} />
				</div>
				<h3 class="text-xl font-bold mb-3">{t.rental.monthTitle}</h3>
				<p class="text-muted-foreground leading-relaxed mb-6">{t.rental.monthDesc}</p>
				<a
					href={localePath(locale, 'contact')}
					class="inline-flex items-center gap-1.5 text-primary text-sm font-medium hover:underline"
				>
					{t.rental.learnMore}
					<ArrowRight size={14} />
				</a>
			</div>
		</div>
	</div>
</section>
