---
import { Image } from "astro:assets";
import heroCarImage from "@/assets/images/kia-carnival.png";
import { ArrowRight, Check } from "lucide-react";
import { BackgroundRippleEffect } from "@/components/ui/background-ripple-effect";
import { buttonVariants } from "@/components/ui/button";
import { useTranslations, type Locale } from "@/i18n/translations";
import { localePath } from "@/i18n/paths";
import { CONTACT, HERO_PRICE_FROM } from "@/lib/constants";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

function formatPrice(n: number) {
	return n.toLocaleString("vi-VN") + "đ";
}
---

<section
	class="relative min-h-[90vh] flex items-center bg-background overflow-hidden"
>
	<BackgroundRippleEffect client:load cellSize={56} cols={100} rows={14} />
	<div
		class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-background pointer-events-none"
	>
	</div>

	<div class="relative container mx-auto px-4 py-24">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
			<!-- Left: text -->
			<div class="flex flex-col gap-6">
				<p
					class="text-xs font-semibold uppercase tracking-[0.2em] text-primary"
				>
					{t.hero.trust.join(" · ")}
				</p>

				<h1
					class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1]"
				>
					{
						t.hero.title.split("\n").map((line, i) => (
							<span>
								{i > 0 && <br />}
								{i === 1 ? <span class="text-primary">{line}</span> : line}
							</span>
						))
					}
				</h1>

				<p class="text-lg text-muted-foreground max-w-md leading-relaxed">
					{t.hero.subtitle}
				</p>

				<div class="inline-flex items-baseline gap-1.5">
					<span class="text-sm text-muted-foreground">{t.hero.fromPrice}</span>
					<span class="text-3xl font-bold text-primary"
						>{formatPrice(HERO_PRICE_FROM)}</span
					>
					<span class="text-sm text-muted-foreground">{t.hero.perDay}</span>
				</div>

				<div class="flex flex-wrap gap-3">
					<a
						href={CONTACT.ZALO_URL}
						target="_blank"
						rel="noopener noreferrer"
						class={buttonVariants({
							variant: "default",
							size: "lg",
							className: "px-7 py-3 h-auto text-base font-semibold",
						})}
					>
						{t.hero.ctaPrimary}
					</a>
					<a
						href={localePath(locale, "fleet")}
						class={buttonVariants({
							variant: "outline",
							size: "lg",
							className: "px-7 py-3 h-auto text-base font-semibold gap-2",
						})}
					>
						{t.hero.ctaSecondary}
						<ArrowRight size={16} />
					</a>
				</div>

				<div class="flex flex-wrap gap-4 pt-2">
					{
						t.hero.trust.map((item) => (
							<span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
								<Check
									size={14}
									className="text-primary shrink-0"
									strokeWidth={2.5}
								/>
								{item}
							</span>
						))
					}
				</div>
			</div>

			<!-- Right: hero car image -->
			<div class="hidden md:flex items-center justify-center self-stretch">
				<div class="relative flex items-center w-full h-[80vh]">
					<div class="absolute inset-0 bg-primary/10 blur-3xl rounded-full">
					</div>
					<Image
						src={heroCarImage}
						alt="Kia Carnival – Nam Thanh Car"
						class="relative w-full h-full object-contain drop-shadow-2xl z-4"
						loading="eager"
						fetchpriority="high"
						quality="mid"
					/>
				</div>
			</div>
		</div>
	</div>
</section>
